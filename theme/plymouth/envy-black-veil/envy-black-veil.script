// ENVY BLACK VEIL boot splash (Plymouth "script" module).
// Draws the wordmark logo, an accent bar with a travelling spark, and a LUKS
// passphrase prompt. logo.png and spark.png are rendered from the SVGs in this
// directory at package-build time (see packaging/envy-black-veil-theme.spec).

// --- Background --------------------------------------------------------------
Window.SetBackgroundTopColor(0.020, 0.027, 0.075);      // #050713
Window.SetBackgroundBottomColor(0.012, 0.016, 0.047);   // slightly darker

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// --- Logo (centred, upper third) --------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 0);

// --- Accent bar + travelling spark ------------------------------------------
bar.width = logo.image.GetWidth();
bar.x = screen_width / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 26;

spark.image = Image("spark.png");
spark.sprite = Sprite(spark.image);
spark.sprite.SetY(bar.y - spark.image.GetHeight() / 2);

progress = 0;
fun refresh_callback() {
    progress++;
    t = (progress / 90);
    frac = t - Math.Int(t);                 // 0..1 sweep, looping
    spark.sprite.SetX(bar.x + frac * bar.width);
    // gently pulse the spark opacity
    pulse = 0.55 + 0.45 * Math.Sin(progress / 7);
    spark.sprite.SetOpacity(pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Boot progress (fills the bar faintly behind the spark) -----------------
fun boot_progress_callback(duration, pct) {
    // Kept subtle; the spark is the primary motion.
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

// --- LUKS passphrase prompt (encrypted disks) -------------------------------
prompt.text = "";
status_sprite = Sprite();
status_sprite.SetPosition(screen_width / 2 - 220, bar.y + 48, 1);

fun display_password_callback(prompt_string, bullets) {
    masked = "";
    i = 0;
    while (i < bullets) { masked = masked + "*"; i++; }
    label = Image.Text(prompt_string + "  " + masked, 0.95, 0.96, 1.0, 1.0, "Sans 14");
    status_sprite.SetImage(label);
    status_sprite.SetX(screen_width / 2 - label.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    status_sprite.SetImage(Image.Text(""));
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Status messages --------------------------------------------------------
message_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.72, 0.77, 0.87, 1.0, "Sans 10");   // muted ink
    message_sprite.SetImage(img);
    message_sprite.SetPosition(screen_width / 2 - img.GetWidth() / 2, screen_height - 60, 2);
}
Plymouth.SetMessageFunction(message_callback);
