// ENVY BLACK VEIL boot splash (Plymouth "script" module).
// Draws the wordmark logo, an accent bar with a travelling spark, and a LUKS
// passphrase prompt. logo.png and spark.png are rendered from the SVGs in this
// directory at package-build time (see packaging/envy-black-veil-theme.spec).

// --- Background --------------------------------------------------------------
Window.SetBackgroundTopColor(0.020, 0.027, 0.075);      // #050713
Window.SetBackgroundBottomColor(0.012, 0.016, 0.047);   // slightly darker

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// --- Logo (centred, upper third) --------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 0);

// --- Accent bar + travelling spark ------------------------------------------
bar.width = logo.image.GetWidth();
bar.x = screen_width / 2 - bar.width / 2;
bar.y = logo.y + logo.image.GetHeight() + 26;

spark.image = Image("spark.png");
spark.sprite = Sprite(spark.image);
spark.sprite.SetY(bar.y - spark.image.GetHeight() / 2);

progress = 0;
fun refresh_callback() {
    progress++;
    t = (progress / 90);
    frac = t - Math.Int(t);                 // 0..1 sweep, looping
    spark.sprite.SetX(bar.x + frac * bar.width);
    // gently pulse the spark opacity
    pulse = 0.55 + 0.45 * Math.Sin(progress / 7);
    spark.sprite.SetOpacity(pulse);
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Boot progress (fills the bar faintly behind the spark) -----------------
fun boot_progress_callback(duration, pct) {
    // Kept subtle; the spark is the primary motion.
}
Plymouth.SetBootProgressFunction(boot_progress_callback);

// --- LUKS passphrase prompt (encrypted disks) -------------------------------
// Drawn from images (prompt.png, entry.png, bullet.png), not text: in the
// initramfs Plymouth may have no font it can load, and then any text is
// invisible. Where a font does load, the request's own words (which disk)
// appear under the box as well.
prompt.image = Image("prompt.png");
prompt.sprite = Sprite(prompt.image);
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
bullet.image = Image("bullet.png");
bullet.gap = 6;
bullet.max = Math.Int((entry.image.GetWidth() - 32) / (bullet.image.GetWidth() + bullet.gap));
bullet.shown = 0;

entry.x = screen_width / 2 - entry.image.GetWidth() / 2;
prompt.y = bar.y + 44;
entry.y = prompt.y + prompt.image.GetHeight() + 10;
prompt.sprite.SetPosition(entry.x, prompt.y, 2);
entry.sprite.SetPosition(entry.x, entry.y, 2);
detail.sprite = Sprite();
detail.sprite.SetPosition(entry.x, entry.y + entry.image.GetHeight() + 12, 2);

fun show_prompt(opacity) {
    prompt.sprite.SetOpacity(opacity);
    entry.sprite.SetOpacity(opacity);
    detail.sprite.SetOpacity(opacity);
}
show_prompt(0);

fun display_password_callback(prompt_string, bullets) {
    show_prompt(1);
    for (index = 0; index < bullet.max && (index < bullets || index < bullet.shown); index++) {
        if (!bullet.sprites[index]) {
            bullet.sprites[index] = Sprite(bullet.image);
            bullet.sprites[index].SetPosition(entry.x + 16 + index * (bullet.image.GetWidth() + bullet.gap),
                                              entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2, 3);
        }
        if (index < bullets) {
            bullet.sprites[index].SetOpacity(1);
        } else {
            bullet.sprites[index].SetOpacity(0);
        }
    }
    bullet.shown = bullets;
    detail.image = Image.Text(prompt_string, 0.72, 0.77, 0.87, 1.0, "Sans 11");
    detail.sprite.SetImage(detail.image);
    detail.sprite.SetX(screen_width / 2 - detail.image.GetWidth() / 2);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    show_prompt(0);
    for (index = 0; index < bullet.shown && index < bullet.max; index++) {
        bullet.sprites[index].SetOpacity(0);
    }
    bullet.shown = 0;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Status messages --------------------------------------------------------
message_sprite = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.72, 0.77, 0.87, 1.0, "Sans 10");   // muted ink
    message_sprite.SetImage(img);
    message_sprite.SetPosition(screen_width / 2 - img.GetWidth() / 2, screen_height - 60, 2);
}
Plymouth.SetMessageFunction(message_callback);
